---
/**
 * Logo geométrico de Blossom Bytes (marca angular tipo "M/N").
 * Reconstruido en SVG a partir del diseño original.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  role="img"
  aria-label="Blossom Bytes"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="bb-logo" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#7ab0dd" />
      <stop offset="1" stop-color="#2f5f8a" />
    </linearGradient>
  </defs>
  <!-- trazo diagonal ascendente + descendente formando la marca -->
  <path
    d="M10 54 V14 L24 34 V10"
    stroke="url(#bb-logo)"
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M40 54 V30 L54 50 V10"
    stroke="url(#bb-logo)"
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
